{
    "configurations": [
        {
            "name": "STM",
            "includePath": [
                "/usr/lib/arm-none-eabi/include",
                "/usr/lib/gcc/arm-none-eabi/13.2.1/include",
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/Core/Config",
                "${workspaceFolder}/lib/ST/STM32G4xx_HAL_Driver/Inc",
                "${workspaceFolder}/lib/ARM/CMSIS/Device/ST/STM32G4xx/Include",
                "${workspaceFolder}/lib/ARM/CMSIS/Include",
                "${workspaceFolder}/lib/GTSR/stmlibs/g4/inc",
                "${workspaceFolder}/build/**/version",
                "${workspaceFolder}/lib/third-party/**",
                "${workspaceFolder}/lib/third-party/printf/src"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32G474xx",
                "GTSR_DEBUG",
                "__ARM_ARCH=7",
                "__ARM_ARCH_7EM__=1",
                "__ARM_FEATURE_DSP=1",
                "__ARMEL__=1",
                "__GNUC__",
                "__ARM_FP=4",
                "__ARM_PCS_VFP=1",
                "__FP_FAST_FMAF=1",
                "__VFP_FP__=1",
                "PRINTF_INCLUDE_CONFIG_H"
            ],
            "compilerPath": "arm-none-eabi-gcc",
            "compilerArgs": [
                "-Wall",
                "-Wextra",
                "-Wdouble-promotion",
                "-ffreestanding",
                "-mcpu=cortex-m4",
                "-mfpu=fpv4-sp-d16",
                "-mfloat-abi=hard"
            ],
            "cStandard": "gnu17",
            "intelliSenseMode": "gcc-arm",
            "cppStandard": "c++23"
        }
    ],
    "version": 4
}
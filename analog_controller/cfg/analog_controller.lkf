#	LINK COMMAND FILE FOR ANALOG CONTROLLER

+seg .text -b 0x8080 -n .text		# program start address
+seg .const -a .text -n .const		# constants follow vector
+seg .bsct -b 0x0 -m 0x100		    # zero page start address
+seg .data -b 0x100 -n .data
+seg .bss -a .data -n .bss

"C:\Program Files (x86)\COSMIC\FSE_Compilers\CXSTM8\Lib\crtsi0.sm8"					# startup routine

# program files
./build/interrupt.o
./build/main.o

# float and integer library names depend on the model used
"C:\Program Files (x86)\COSMIC\FSE_Compilers\CXSTM8\Lib\libis0.sm8"
"C:\Program Files (x86)\COSMIC\FSE_Compilers\CXSTM8\Lib\libm0.sm8"


# interrupt vector initialization
+seg .vector -b 0x8000 -m 0x80		# vectors start address
./build/vector.o				            # interrupt vectors


# define these symbols if crtsi is used
+def __endzp=@.ubsct			# end of uninitialized zpage
+def __memory=@.bss			# end of bss segment
+def __stack=0x1ff
